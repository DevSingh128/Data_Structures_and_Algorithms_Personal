class Solution {
    public int characterReplacement(String s, int k) {
        int ei = 0;
        int si = 0;
        int ans = 0;
        int[] max = new int[26];
        int maxfreq = 0;
        while(ei < s.length()){
            char c = s.charAt(ei);
            max[c-'A']++;
            maxfreq = Math.max(maxfreq,max[c-'A']);
            while((ei-si+1) - maxfreq > k){
                max[s.charAt(si) - 'A']--;
                si++;
            }
            ans = Math.max(ans,ei-si+1);
            ei++;
        }

        return ans;
    }
}
