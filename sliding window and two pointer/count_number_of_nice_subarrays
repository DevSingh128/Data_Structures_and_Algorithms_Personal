class Solution {
    public int numberOfSubarrays(int[] nums, int k) {
        return function(nums,k) - function(nums,k-1);
    }

    public int function(int[] nums, int k){
        if(k < 0)return 0;
        int n = nums.length;
        for(int i=0;i<n;i++){
            if(nums[i] % 2 == 0)nums[i] = 0;
            if(nums[i] % 2 != 0)nums[i] = 1;
        }
        int ei = 0;
        int si = 0;
        int cnt = 0;
        int currsum = 0;
        while(ei < n){
            currsum += nums[ei];
            while(si <= ei && currsum > k){
                currsum -= nums[si];
                si++;
            }
            cnt += ei - si + 1;
            ei++;
        }
        return cnt;
    }
}
