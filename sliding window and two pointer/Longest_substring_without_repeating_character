class Solution {
    public int lengthOfLongestSubstring(String s) {
        int si = 0;
        int ei = 0;
        int ans = 0;
        int[] freq = new int[256];
        while(ei < s.length()){
            char ch = s.charAt(ei);
            freq[ch]=freq[ch] + 1;
            
            while(freq[ch] > 1){
                char c = s.charAt(si);
                freq[c]=freq[c] - 1;;
                si++;
            }
            ans = Math.max(ans , ei - si + 1 );
            ei++;
        } 
        return ans;
    }
}
