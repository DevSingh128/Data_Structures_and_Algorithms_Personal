class Solution {
    public int longestOnes(int[] nums, int k) {
        int ei = 0;
        int si = 0;
        int ans = 0;
        while(ei < nums.length){
            if(nums[ei] == 0){
                k--;
            }
             while(si <= ei && k<0){
                    if(nums[si] == 0){
                        k++;
                    }
                    si++;
                }
            
            ans = Math.max(ei-si+1,ans);
            ei++;
        }

        return ans;
    }
}
