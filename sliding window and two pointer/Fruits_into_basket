class Solution {
    public int totalFruit(int[] fruits) {
        HashMap<Integer,Integer>hm = new HashMap<>();
        int count = 0;
        int ans = 0;
        int ei = 0;
        int si = 0;
        while(ei < fruits.length){
            hm.put(fruits[ei] , hm.getOrDefault(fruits[ei],0)+1);
            while(hm.size() > 2){
                hm.put(fruits[si] , hm.get(fruits[si])-1);
                if(hm.get(fruits[si]) == 0){
                    hm.remove(fruits[si]);
                }
                si++;
            }
            ans = Math.max(ei-si+1,ans);
            ei++;
        }

        return ans;
    }
}
