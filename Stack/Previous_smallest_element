class Solution {
    public static ArrayList<Integer> prevSmaller(int[] arr) {
        // code here
        int n = arr.length;
        Stack <Integer> s = new Stack<>();
        ArrayList<Integer> ans = new ArrayList<>();
        //for leftest element
        for(int i=0;i<n;i++){
            while(!s.isEmpty() && s.peek() >= arr[i]){
                s.pop();
            }
            if(s.isEmpty()){
                ans.add(-1);
            }
            else{
                ans.add(s.peek());
            }
            s.push(arr[i]);
        }
        return ans;
    }
}
