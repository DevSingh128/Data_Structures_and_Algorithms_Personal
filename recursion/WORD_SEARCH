IF first character found then deep down and if on recursive call because to check every possibility
if idx == length of word base case
if out of bound return false
row and col initialize with up , down , left , right
runs loop on these 4 and add to respective row and column
use board and mark '*' because of infinite loop testcase :"ABA"


class Solution {
    public boolean exist(char[][] board, String word) {
        for(int i=0;i<board.length;i++){
            for(int j=0;j<board[0].length;j++){
                if(board[i][j] == word.charAt(0)){
                    if(sol(board,word,0,i,j)){
                        return true;
                    } 
                }
            }
        }
        return false;
    }

    public boolean sol(char[][] board,String word,int idx,int i,int j){
        if(idx == word.length()){
            return true;
        }
        if(i < 0 || j < 0 || i >= board.length || j >= board[0].length
        || board[i][j] != word.charAt(idx)){
        return false;
        }       

        int row[] = {-1,1,0,0};
        int col[] = {0,0,-1,1};

        char temp = board[i][j];
        board[i][j] = '*';
        for(int k=0;k<4;k++){
            if(sol(board,word,idx+1,i+row[k],j+col[k])) return true;
        }
        board[i][j] = temp;
        return false;
    }
}
