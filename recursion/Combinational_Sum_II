//no duplicates and not more than one time use
thats why sort array and check condition of current and nextelement (i>idx) if same //skip and candidate[i] > amount break
it might generate duplicate because of multiple computation so add in Set and give answer


class Solution {
    public List<List<Integer>> combinationSum2(int[] candidates, int target) {
        List<Integer> ll = new ArrayList<>();
        List<List<Integer>> as = new ArrayList<>();
        Arrays.sort(candidates);
        combination(candidates,target,ll,0,as);

        Set<String> seen = new HashSet<>();
        List<List<Integer>> result = new ArrayList<>();
        for (List<Integer> list : as) {
            String key = list.toString(); 
            if (seen.add(key)) {
            result.add(new ArrayList<>(list));  
            }
        }
        return result;
    }
    public static void combination(int[] candidates, int amount,List<Integer> ll,int idx,List<List<Integer>> as){ 
        if(amount == 0){
            as.add(new ArrayList<>(ll));
            return;
        }
        for(int i = idx ; i<candidates.length;i++){
            if(amount < candidates[i]){
                break;
            }
            if (i > idx && candidates[i] == candidates[i - 1]) continue;
            ll.add(candidates[i]);
            combination(candidates,amount-candidates[i],ll,i+1,as);
            ll.remove(ll.size()-1);
        }
    }
}
