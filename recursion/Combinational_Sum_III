//logic
in base case check
count of number of elements => sum of element => add in final arraylist

same run loop from idx which pass as 1 initially upto 9 and 
same recursion from initial variable i+1 because no duplicate element are there and sum + i

class Solution {
    public List<List<Integer>> combinationSum3(int k, int n) {
        int tn = n;
        int tq = k;
        List<Integer> temp = new ArrayList<>();
        List<List<Integer>> ans = new ArrayList<>();
        combinations(tn,tq,1,temp,ans,0);
        return ans;
    }
    
    public static void combinations(int tn, int tq,  int idx,List<Integer> temp, List<List<Integer>> ans,int sum) {
        if(temp.size() == tq){
            if(sum == tn){
            ans.add(new ArrayList<>(temp));
            }
            return;
        }
        for(int i = idx; i <= 9; i++){
            if(sum + i > tn)break;
            temp.add(i);
            combinations(tn,  tq, i+1,  temp,ans,sum + i);
            temp.remove(temp.size()-1);
        }
    }
}
