class Solution {
    public Node lca(Node root, int p, int q) {
            // code here
        if(root == null || root.data == p || root.data == q){
            return root;
        }
        
        Node l = lca(root.left,p,q);
        Node r = lca(root.right,p,q);
        
        if(l!=null && r!= null){
            return root;
        }
        
        return l!=null?l : r;
    }
    
    public int height(Node root,int n,int count){
    if (root == null) {
        return -1;
    }
    
    if (root.data == n) {
        return count;
    }

    int left = height(root.left, n, count + 1);
    int right = height(root.right, n, count + 1);

    return (left != -1) ? left : right;
    }
    
    
    
    public int findDist(Node root, int a, int b) {
        // code here
        int dist = 0;
        int count1 = 0;
        int count2 = 0;
        Node ancestor = lca(root,a,b);
        if(ancestor != null){
             count1 = height(ancestor,a,count1);
             count2 = height(ancestor,b,count2);
             
             dist = count1 + count2;
        }
        return dist;
        
    }
}
