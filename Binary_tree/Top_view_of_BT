*******************************************************************// USE LEVEL ORDER TRAVERSAL//*******************************************************************************
class Solution {
    
    static class Pair {
        Node node;
        int x;
        Pair(int x,Node node) {
            this.node = node;
            this.x = x;
        }
    }
        
    public ArrayList<Integer> topView(Node root) {
        // code here'
        ArrayList<Integer> ans = new ArrayList<>();
        if (root == null) return ans;
        
        TreeMap<Integer,Integer>hm = new TreeMap<>();
        Queue<Pair>q = new LinkedList<>();
        q.add(new Pair(0,root));
        
        
        while(!q.isEmpty()){
            Pair curr = q.remove();
            Node node = curr.node;
                
                if(!hm.containsKey(curr.x)){
                    hm.put(curr.x,node.data);
                }
                
                if(node.left != null){
                    q.add(new Pair(curr.x-1,node.left));
                    
                }
                if(node.right != null){
                    q.add(new Pair(curr.x+1,node.right));
                }
            
        }

        
        for(int val : hm.values()) {
            ans.add(val);
        }
        
    
        return ans;
    }

}
