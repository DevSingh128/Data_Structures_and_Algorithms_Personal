1.mid taken as column and find largest element in it after it check the any other largest element in that particular row
2. if not found it is peak element else check with other column 

class Solution {
    public int findlargestelementandrow(int[][] mat,int col){
        int n = mat.length;
        int m = mat[0].length;
        int max = Integer.MIN_VALUE;
        int idx = -1;
        for(int i=0;i<n;i++){
            if (mat[i][col] > max) {
                max = mat[i][col];
                idx = i;
            }
        }
        return idx;
    }


    public int[] findPeakGrid(int[][] mat) {
        int i = 0;
        int n = mat.length;
        int m = mat[0].length;
        int j = m-1;

        while(i <= j){
            int mid = i + (j-i)/2;
            int row = findlargestelementandrow(mat,mid);

            int left = mid - 1 >= 0 ? mat[row][mid - 1] : Integer.MIN_VALUE;
            int right = mid + 1 < m ? mat[row][mid + 1] : Integer.MIN_VALUE;
            
            if (mat[row][mid] > left && mat[row][mid] > right) {
                  return new int[]{row, mid};
              } else if (left > mat[row][mid]) {
                   j = mid - 1;
              } else {
                   i = mid + 1;
              }
        }
        return new int[]{i , j};
    }
}
