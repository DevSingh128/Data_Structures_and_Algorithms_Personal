//check the target == arr[mid]
//if not then search in right sorted path(arr[st] <= arr[mid]) then => target <= arr[mid] && target >= arr[start]
//if not then search in left sorted path () => target <= arr[high] && target >= arr[mid] 
class Solution {
    public int search(int[] nums, int target) {
        int start = 0;
        int end = nums.length-1;
        while(start<=end){
            int mid = start + (end - start)/2;
            if(nums[mid]==target){
                return mid;
            } 

            if(nums[start] <= nums[mid]){
                if(nums[start]<=target && nums[mid]>=target ){
                    end = mid - 1;
                }
                else{
                    start = mid + 1;
                }
            }

            else {
                if (nums[mid]<=target && nums[end]>=target){
                    start=mid+1;
                }
                else{
                    end=mid-1;
                }
            }
        }
    return -1;
    }
}
