else false 


class Solution {
    public int aggressiveCows(int[] stalls, int k) {
        // code here
        Arrays.sort(stalls);

        int i = 1; 
        int j = stalls[stalls.length - 1] - stalls[0]; 
        int ans = 0;

        while (i <= j) {
            int mid = i + (j - i) / 2;

            if (ispossible(stalls, k, mid)) {
                ans = mid;
                i = mid + 1;
            } else {
                j = mid - 1;
            }
        }
        return ans;
    }
    
    public boolean ispossible(int[] stalls, int k,int mid){
        int cows = 1;   
        int lastPos = stalls[0];

        for (int i = 1; i < stalls.length; i++) {
            if (stalls[i] - lastPos >= mid) {
                cows++;
                lastPos = stalls[i];
            }
            if (cows == k) {
                return true;
            }
        }
        return false;
    }
}
