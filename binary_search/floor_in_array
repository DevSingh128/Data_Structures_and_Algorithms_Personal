//combine target equal and target > mid of array 
//return ans and update through it

class Solution {
    public int findFloor(int[] nums, int target) {
        // code here
        int start = 0 ;
        int end = nums.length - 1;
        int ans = -1;

        while(start<=end){
            int mid = start + (end-start)/2;
            if(nums[mid]<=target){
                ans = mid;
                start = mid + 1;
            }

            else{
                end = mid - 1;
            }
         
        }
        return ans;
    }
}
