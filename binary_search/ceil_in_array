// similar to floor
class Solution {
    public int findCeil(int[] arr, int x) {
        // code here
        int ans = -1;
        int i = 0;
        int j = arr.length - 1;
        while(i<=j){
            int m = i + (j-i)/2;
            if(arr[m] >= x){
                ans = m;
                j = m -1;
            }
            
            else{
                i = m + 1;
            }
        }
        return ans;
    }
}
