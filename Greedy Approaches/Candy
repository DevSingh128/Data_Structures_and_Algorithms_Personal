make all array 1.
traverse left to right and increase candy by 1 if neighbior is big
traverse right to left and increase and take max of both increase and current value if neighbour is big

class Solution {
    public int candy(int[] ratings) {
        int count = 0;
        int n = ratings.length;
        int[] arr = new int[n];
        for(int i=0;i<arr.length;i++){
            arr[i] = 1;
        }

        for (int i = 1; i < n; i++) {
        if (ratings[i] > ratings[i - 1]) {
            arr[i] = arr[i - 1] + 1;
            }
        }


    for (int i = n - 2; i >= 0; i--) {
        if (ratings[i] > ratings[i + 1]) {
            arr[i] = Math.max(arr[i] , arr[i + 1] + 1);
        }
    }

    for (int candy : arr) {
        count += candy;
    }
    return count;
    }
}
