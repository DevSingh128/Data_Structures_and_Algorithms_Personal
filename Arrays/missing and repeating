class Solution {
    ArrayList<Integer> findTwoElement(int arr[]) {
        // code here
    int n = arr.length;
    HashMap<Integer, Integer> hm = new HashMap<>();
    int repeating = -1, missing = -1;

    for (int num : arr) {
        hm.put(num, hm.getOrDefault(num, 0) + 1);
    }

    for (int i = 1; i <= n; i++) {
        if (!hm.containsKey(i)) {
            missing = i;
        } else if (hm.get(i) > 1) {
            repeating = i;
        }
    }

    ArrayList<Integer> res = new ArrayList<>();
    res.add(repeating);
    res.add(missing);
    return res;
        
    }
}
